{
  "name": "u-jednoho-stolu",
  "version": "1.2.8",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "dev:node": "node scripts/dev-node.mjs",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "check": "tsc --noEmit",
    "content:rooms": "node --experimental-strip-types scripts/content-rooms.mjs",
    "content:sync": "node scripts/sync-content.mjs",
    "check:client-content": "node --experimental-strip-types scripts/check-content.mjs --client",
    "check:content": "node scripts/sync-content.mjs --check && node --experimental-strip-types scripts/check-content.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run check:docs && npm run check:css && npm run check:content && npm run check && npm test",
    "test": "node --experimental-strip-types scripts/test-union.mjs",
    "db:init": "node scripts/init-db.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:ci": "node scripts/test-ci.mjs",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node server/start.mjs",
    "benchmark:generator": "node --experimental-strip-types scripts/benchmark-generator.mjs",
    "test:updater": "node scripts/test-updater.mjs",
    "test:hosting": "node scripts/test-hosting.mjs",
    "catalog:demo": "node scripts/catalog-demo.mjs",
    "test:catalog-audit": "node scripts/test-catalog-audit.mjs",
    "test:catalogs": "node scripts/test-catalog-migration.mjs && node scripts/test-catalog-zip.mjs && node scripts/test-catalog-store.mjs && node scripts/test-catalog-github.mjs && node scripts/test-catalog-admin.mjs && node scripts/test-catalog-audit.mjs",
    "lint:baseline": "node scripts/check-lint.mjs",
    "test:stabilization": "node scripts/test-stabilization.mjs && node scripts/test-room-admission.mjs && node scripts/test-message-hosting.mjs && node scripts/test-admin-client.mjs && node scripts/test-admin-behavior.mjs",
    "benchmark:polling": "node scripts/benchmark-polling.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "json-rpc-2.0": "1.7.1",
    "prettier": "3.6.2",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.7",
    "wrangler": "4.159.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "description": "Jednoduchý český online herní stůl pro vlastní fantasy dobrodružství.",
  "license": "MIT",
  "author": "Jan Dvořák",
  "repository": {
    "type": "git",
    "url": "https://github.com/cert4u/u-jednoho-stolu.git"
  },
  "bugs": {
    "url": "https://github.com/cert4u/u-jednoho-stolu/issues"
  },
  "homepage": "https://github.com/cert4u/u-jednoho-stolu#readme"
}
