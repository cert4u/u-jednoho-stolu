# Externí adresa bez cesty. HTTPS za reverzní proxy; pro místní test http://localhost:8080
PUBLIC_ORIGIN=https://stul.example.cz
# Vygeneruj každou hodnotu zvlášť: openssl rand -hex 32
STUL_ADMIN_PASSWORD=
STUL_UPDATER_TOKEN=
# Výchozí vazba pro reverzní proxy na stejném serveru
STUL_BIND=127.0.0.1
STUL_PORT=8080
STUL_APP_CONTAINER=stul-app
