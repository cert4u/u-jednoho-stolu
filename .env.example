# Externí adresa bez cesty. HTTPS za reverzní proxy; pro místní test http://localhost:8080
PUBLIC_ORIGIN=https://stul.example.cz
# Vygeneruj každou hodnotu zvlášť: openssl rand -hex 32
STUL_ADMIN_PASSWORD=
STUL_UPDATER_TOKEN=
# Výchozí vazba pro reverzní proxy na stejném serveru
STUL_BIND=127.0.0.1
STUL_PORT=8080
STUL_APP_CONTAINER=stul-app

# Volitelné hlasové volání (adresa dostupná z PROHLÍŽEČŮ hráčů)
# Veřejně wss://hlas.example.cz; lokálně ws://localhost:7880
STUL_LIVEKIT_URL=
# Klíč např. openssl rand -hex 12; tajemství openssl rand -hex 32
STUL_LIVEKIT_API_KEY=
STUL_LIVEKIT_API_SECRET=
# Pro veřejný server nastav ./deploy/livekit/public.yaml a uprav síť dle docs/VOICE.md
STUL_LIVEKIT_CONFIG=./deploy/livekit/local.yaml
